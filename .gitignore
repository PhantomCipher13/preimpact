# ==============================================================================
# PreImpact .gitignore
# ==============================================================================

# Environment & Secrets
.env
.env.*
!.env.example
*.env

# Python & Testing Caches
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# Node & Frontend Build Artifacts
node_modules/
frontend/node_modules/
dist/
frontend/dist/
build/
frontend/build/
.eslintcache

# IDE & Editor Files
.vscode/
.idea/
*.swp
*.swo
*.sublime-project
*.sublime-workspace

# OS-Specific Files
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini

# Logs & Debug Output
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Root OSMnx HTTP Download Cache
/cache/

# Preserve Essential Data Assets in backend/data/cache
!backend/data/cache/
!backend/data/cache/**

# Media Generation Scratch & Video Artifacts
demo_frames/
demo_frames_hd/
visual_validation/
preimpact_audio.mp4
preimpact_audio.wav
*.wav

